let currentLab = 1;
let lab1SubMode = 1; 
let selectedSolution = 'NaOH';
let selectedIndicator = 'litmus';
let selectedLab2Salt = 'NaOH';
let selectedCation = 'Li+';
let lastResult = null;
let savedReports = [];

const lab1DataMode1 = {
    'NaOH': { name: 'Гидроксид натрия (NaOH)', color: '#3B82F6', ph: '12-14', type: 'щелочная', paperColor: '#1D4ED8' },
    'HCl': { name: 'Соляная кислота (HCl)', color: '#EF4444', ph: '1-2', type: 'кислотная', paperColor: '#DC2626' },
    'NaHCO3': { name: 'Питьевая сода (NaHCO₃)', color: '#0EA5E9', ph: '10-11', type: 'щелочная', paperColor: '#0284C7' },
    'Lemon': { name: 'Лимонный сок', color: '#F97316', ph: '3-4', type: 'кислотная', paperColor: '#EA580C' },
    'Water': { name: 'Вода (H₂O)', color: '#FBBF24', ph: '7', type: 'нейтральная', paperColor: '#D97706' }
};

const lab1DataMode2 = {
    'H2SO4': {
        name: 'Серная кислота (H₂SO₄)',
        litmus: { color: 'rgba(239, 68, 68, 0.8)', text: 'Красный', glow: 'rgba(239, 68, 68, 0.4)' },
        orange: { color: 'rgba(244, 63, 94, 0.8)', text: 'Розово-красный', glow: 'rgba(244, 63, 94, 0.4)' },
        phenol: { color: 'rgba(248, 250, 252, 0.5)', text: 'Бесцветный', glow: 'transparent' }
    },
    'KOH': {
        name: 'Гидроксид калия (KOH)',
        litmus: { color: 'rgba(59, 130, 246, 0.8)', text: 'Синий', glow: 'rgba(59, 130, 246, 0.4)' },
        orange: { color: 'rgba(234, 179, 8, 0.8)', text: 'Желтый', glow: 'rgba(234, 179, 8, 0.4)' },
        phenol: { color: 'rgba(236, 72, 153, 0.8)', text: 'Малиновый', glow: 'rgba(236, 72, 153, 0.4)' }
    },
    'CH3COONa': {
        name: 'Мыльный раствор',
        litmus: { color: 'rgba(96, 165, 250, 0.7)', text: 'Слабо-синий', glow: 'rgba(96, 165, 250, 0.4)' },
        orange: { color: 'rgba(250, 204, 21, 0.7)', text: 'Желтый', glow: 'rgba(250, 204, 21, 0.3)' },
        phenol: { color: 'rgba(244, 114, 182, 0.7)', text: 'Слабо-малиновый', glow: 'rgba(244, 114, 182, 0.3)' }
    }
};

const lab2Data = {
    'NaOH': { name: 'Гидроксид натрия', color: 'rgba(59, 130, 246, 0.8)', glow: 'rgba(59, 130, 246, 0.4)', ph: '13-14', medium: 'Щелочная', eq: 'Не гидролизуется' },
    'Na2CO3': { name: 'Карбонат натрия', color: 'rgba(14, 165, 233, 0.8)', glow: 'rgba(14, 165, 233, 0.4)', ph: '10-11', medium: 'Щелочная', eq: 'Na₂CO₃ + H₂O ⇌ NaHCO₃ + NaOH' },
    'BaCl2': { name: 'Хлорид бария', color: 'rgba(250, 204, 21, 0.6)', glow: 'rgba(250, 204, 21, 0.2)', ph: '7', medium: 'Нейтральная', eq: 'Не гидролизуется' }
};

const flameData = {
    'Li+': { name: 'Литий (Li⁺)', color: '#E60049', flameText: 'Карминно-красный' },
    'Na+': { name: 'Натрий (Na⁺)', color: '#FFB703', flameText: 'Желтый' },
    'K+': { name: 'Калий (K⁺)', color: '#9D4EDD', flameText: 'Фиолетовый' },
    'Ca2+': { name: 'Кальций (Ca²⁺)', color: '#D90429', flameText: 'Кирпично-красный' },
    'Sr2+': { name: 'Стронций (Sr²⁺)', color: '#EF233C', flameText: 'Красный' },
    'Ba2+': { name: 'Барий (Ba²⁺)', color: '#8AC926', flameText: 'Желто-зеленый' },
    'Cu2+': { name: 'Медь (Cu²⁺)', color: '#00A896', flameText: 'Сине-зеленый' }
};

window.onload = () => selectLab(1);

function openLabModal() { document.getElementById('selectionModal').classList.remove('hidden'); }
function closeLabModal() { document.getElementById('selectionModal').classList.add('hidden'); }
function openReportModal() { renderReportTable(); document.getElementById('reportModal').classList.remove('hidden'); }
function closeReportModal() { document.getElementById('reportModal').classList.add('hidden'); }

function selectLab(labNum) {
    currentLab = labNum;
    closeLabModal();
    document.getElementById('controlsLab1').style.display = labNum === 1 ? 'block' : 'none';
    document.getElementById('controlsLab2').style.display = labNum === 2 ? 'block' : 'none';
    document.getElementById('controlsLab3').style.display = labNum === 3 ? 'block' : 'none';

    if (labNum === 1) {
        document.getElementById('headerLabTitle').innerText = '№1 Определение pH';
        switchLab1Mode(1);
    } else if (labNum === 2) {
        document.getElementById('headerLabTitle').innerText = '№2 Гидролиз солей';
        renderLab2Stage();
    } else if (labNum === 3) {
        document.getElementById('headerLabTitle').innerText = '№3 Окрашивание пламени';
        renderLab3Stage();
    }
}

function switchLab1Mode(mode) {
    lab1SubMode = mode;
    const indGroup = document.getElementById('indicatorSelectGroup');
    const container = document.getElementById('lab1Solutions');
    
    document.getElementById('lab1Sub1').classList.toggle('active', mode === 1);
    document.getElementById('lab1Sub2').classList.toggle('active', mode === 2);

    if (mode === 1) {
        indGroup.style.display = 'none';
        selectedSolution = 'NaOH';
        container.innerHTML = `
            <button class="select-btn active" onclick="setSolution('NaOH', this)"><span>Гидроксид натрия</span><div class="radio-dot"></div></button>
            <button class="select-btn" onclick="setSolution('HCl', this)"><span>Соляная кислота</span><div class="radio-dot"></div></button>
            <button class="select-btn" onclick="setSolution('NaHCO3', this)"><span>Питьевая сода</span><div class="radio-dot"></div></button>
            <button class="select-btn" onclick="setSolution('Lemon', this)"><span>Лимонный сок</span><div class="radio-dot"></div></button>
            <button class="select-btn" onclick="setSolution('Water', this)"><span>Дистиллированная вода</span><div class="radio-dot"></div></button>
        `;
    } else {
        indGroup.style.display = 'block';
        selectedSolution = 'H2SO4';
        container.innerHTML = `
            <button class="select-btn active" onclick="setSolution('H2SO4', this)"><span>Серная кислота</span><div class="radio-dot"></div></button>
            <button class="select-btn" onclick="setSolution('KOH', this)"><span>Гидроксид калия</span><div class="radio-dot"></div></button>
            <button class="select-btn" onclick="setSolution('CH3COONa', this)"><span>Мыльный раствор</span><div class="radio-dot"></div></button>
        `;
    }
    renderLab1Stage();
}

function setSolution(solKey, btnElem) {
    selectedSolution = solKey;
    document.querySelectorAll('#lab1Solutions .select-btn').forEach(b => b.classList.remove('active'));
    btnElem.classList.add('active');
    renderLab1Stage();
}

function setIndicator(ind) {
    selectedIndicator = ind;
    document.getElementById('indLitmus').classList.toggle('active', ind === 'litmus');
    document.getElementById('indOrange').classList.toggle('active', ind === 'orange');
    document.getElementById('indPhenol').classList.toggle('active', ind === 'phenol');
}

function renderLab1Stage() {
    const viewport = document.getElementById('labViewport');
    if (lab1SubMode === 1) {
        viewport.innerHTML = `
            <div class="beaker-wrapper">
                <div class="indicator-paper" id="paperStrip"></div>
                <div class="test-tube"><div class="liquid" id="liquidBg"></div></div>
            </div>
        `;
    } else {
        viewport.innerHTML = `
            <div class="beaker-wrapper">
                <div class="pipette"><div class="pipette-drop" id="pipetteDrop"></div></div>
                <div class="test-tube" style="margin-top: 40px;"><div class="liquid" id="liquidBg"></div></div>
            </div>
        `;
    }
    resetResultDisplay();
}

function runExperiment() {
    if (lab1SubMode === 1) {
        const data = lab1DataMode1[selectedSolution];
        const paper = document.getElementById('paperStrip');
        paper.classList.add('dipped');
        
        // Увеличено время для синхронизации с плавной CSS анимацией
        setTimeout(() => {
            paper.style.background = data.paperColor;
            document.getElementById('resultTitle').innerText = `Результат: ${data.name}`;
            document.getElementById('resultSub').innerText = `pH: ${data.ph} | Среда: ${data.type}`;
            
            lastResult = { lab: '№1 (pH)', solution: data.name, color: 'Изменился', ph: data.ph, medium: data.type };
        }, 1000); 
    } else {
        const data = lab1DataMode2[selectedSolution];
        const indInfo = data[selectedIndicator];
        const drop = document.getElementById('pipetteDrop');
        const liquid = document.getElementById('liquidBg');
        
        drop.style.background = indInfo.color.replace(/0\.[0-9]+\)/, '1)');
        drop.classList.remove('animating');
        void drop.offsetWidth; // Рестарт анимации
        drop.classList.add('animating');

        setTimeout(() => {
            liquid.style.background = indInfo.color;
            liquid.style.boxShadow = `0 0 20px ${indInfo.glow}`;
            
            document.getElementById('resultTitle').innerText = `Результат: ${data.name}`;
            document.getElementById('resultSub').innerText = `Цвет: ${indInfo.text}`;

            lastResult = { lab: '№1 (Индикаторы)', solution: data.name, indicator: selectedIndicator, color: indInfo.text, medium: 'Определена' };
        }, 900); // Синхронно с падением капли
    }
}

function selectLab2Salt(saltKey, btn) {
    selectedLab2Salt = saltKey;
    document.querySelectorAll('#controlsLab2 .select-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    renderLab2Stage();
}

function renderLab2Stage() {
    document.getElementById('labViewport').innerHTML = `
        <div class="beaker-wrapper">
            <div class="indicator-paper" id="paperStrip2"></div>
            <div class="test-tube"><div class="liquid" id="liquidBg2"></div></div>
        </div>
    `;
    resetResultDisplay();
}

function runLab2Experiment() {
    const data = lab2Data[selectedLab2Salt];
    const paper = document.getElementById('paperStrip2');
    const liquid = document.getElementById('liquidBg2');
    paper.classList.add('dipped');

    setTimeout(() => {
        paper.style.background = data.color.replace(/0\.[0-9]+\)/, '1)');
        liquid.style.background = data.color;
        liquid.style.boxShadow = `0 0 20px ${data.glow}`;
        
        document.getElementById('resultTitle').innerText = `Результат: ${data.name}`;
        document.getElementById('resultSub').innerText = `Среда: ${data.medium} | ${data.eq}`;

        lastResult = { lab: '№2 (Гидролиз)', solution: data.name, ph: data.ph, medium: data.medium, eq: data.eq };
    }, 1000);
}

function selectCation(cationKey, btn) {
    selectedCation = cationKey;
    document.querySelectorAll('#controlsLab3 .select-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    renderLab3Stage();
}

function renderLab3Stage() {
    document.getElementById('labViewport').innerHTML = `
        <div class="burner-wrapper">
            <div class="wire-tool" id="wireTool"><div class="wire-tip" id="wireTip"></div></div>
            <div class="flame-container"><div class="flame" id="flameElem"></div></div>
            <div class="burner-base"></div>
        </div>
    `;
    resetResultDisplay();
}

function runFlameTest() {
    const data = flameData[selectedCation];
    const wire = document.getElementById('wireTool');
    const flame = document.getElementById('flameElem');
    
    document.getElementById('wireTip').style.background = data.color;
    wire.classList.add('in-flame');

    setTimeout(() => {
        flame.style.background = `radial-gradient(circle at 50% 80%, #60A5FA, ${data.color} 50%, transparent 80%)`;
        flame.style.boxShadow = `0 0 45px ${data.color}`;

        document.getElementById('resultTitle').innerText = `Результат: ${data.name}`;
        document.getElementById('resultSub').innerText = `Пламя: ${data.flameText}`;

        lastResult = { lab: '№3 (Катионы)', cation: data.name, flameColor: data.flameText };
    }, 900); // Синхронно с поворотом палочки
}

function resetResultDisplay() {
    document.getElementById('resultTitle').innerText = 'Результат: Ожидание';
    document.getElementById('resultSub').innerText = 'Запустите опыт для получения данных';
    lastResult = null;
}

function saveToReport() {
    if (!lastResult) return alert('Сначала выполните опыт!');
    savedReports.push(lastResult);
    alert('✅ Сохранено в таблицу отчета!');
}

function renderReportTable() {
    const container = document.getElementById('reportContent');
    if (savedReports.length === 0) return container.innerHTML = `<p style="color: #64748B;">Отчет пока пуст.</p>`;

    let html = `<table class="report-table"><thead><tr><th>№</th><th>Лабораторная</th><th>Вещество</th><th>pH / Цвет</th><th>Среда / Инфо</th></tr></thead><tbody>`;
    savedReports.forEach((item, i) => {
        html += `<tr><td>${i + 1}</td><td>${item.lab}</td><td>${item.solution || item.cation}</td><td>${item.ph || item.flameColor || item.color}</td><td>${item.medium || ''} ${item.eq ? '(' + item.eq + ')' : ''}</td></tr>`;
    });
    container.innerHTML = html + `</tbody></table>`;
}
